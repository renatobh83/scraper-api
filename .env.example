APP_NAME=News Scraper API
APP_VERSION=0.2.0
HOST=0.0.0.0
PORT=8000
NAVIGATION_TIMEOUT_MS=30000
SELECTOR_TIMEOUT_MS=10000
CACHE_TTL_SECONDS=120
BLOCKED_COOLDOWN_SECONDS=60
MAX_NEWS_ITEMS=20
MAX_CONCURRENT_SCRAPES=1
DEBUG_BROWSER=0
DEBUG_PAUSE=0
SAVE_DEBUG_ARTIFACTS=1
DEBUG_ARTIFACT_DIR=/tmp/news-debug

# Opcional: use PROXY_URL ou as três variáveis separadas, não os dois formatos.
PROXY_URL=
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
