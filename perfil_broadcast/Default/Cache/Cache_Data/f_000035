                const almObj = window[masterId];
                if (almObj && almObj.AjaxLoadMore) {
                  almObj.page = 0;
                  almObj.postcount = 0;
                  almObj.finished = false;
                  almObj.loading = false;
                  almObj.disable_ajax = false;
                  almObj.rel = 'next';
                  almObj.AjaxLoadMore.loadPosts();
