            // Dedupe de resultados em client-side por URL do post
            const attachDedupe = (wrap) => {
              const listing = wrap.querySelector('.alm-listing');
              if (!listing || listing.__dedupeAttached) return;
              const prune = () => {
                const seen = new Set();
                const items = listing.querySelectorAll('article');
                items.forEach((art) => {
                  const a = art.querySelector('a[href]');
                  const key = a ? a.href : '';
                  if (!key) return;
                  if (seen.has(key)) art.remove();
                  else seen.add(key);
                });
              };
              prune();
              const mo = new MutationObserver(() => prune());
              mo.observe(listing, { childList: true });
              listing.__dedupeAttached = true;
              listing.__dedupeObserver = mo;
            };
            attachDedupe(almWrap);

            const setActive = (btn) => {
              buttons.forEach(b => b.classList.remove('bg-action-default','text-white'));
              buttons.forEach(b => b.classList.add('bg-primary-100','text-primary-700'));
              btn.classList.remove('bg-primary-100','text-primary-700');
              btn.classList.add('bg-action-default','text-white');
