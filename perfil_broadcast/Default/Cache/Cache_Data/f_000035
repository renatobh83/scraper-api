                const terms = btn.dataset.terms || '';

                if (typeof history.replaceState === 'function') {
                  const url = new URL(window.location.href);
                  if (terms) {
                    url.searchParams.set('category', terms);
                  } else {
                    url.searchParams.delete('category');
                  }
                  history.replaceState({}, '', url.toString());
                }

                const listing = almWrap.querySelector('.alm-listing');
                if (listing) {
                  if (taxonomy && terms) {
                    listing.setAttribute('data-taxonomy', taxonomy);
                    listing.setAttribute('data-taxonomy-terms', terms);
                    listing.setAttribute('data-taxonomy-operator', 'IN');
                  } else {
                    listing.removeAttribute('data-taxonomy');
                    listing.removeAttribute('data-taxonomy-terms');
                    listing.removeAttribute('data-taxonomy-operator');
                  }
                  // Limpa conteúdo atual antes de re-inicializar
                  const paging = listing.querySelector('.alm-paging-content');
                  if (paging) paging.innerHTML = '';
                  else listing.innerHTML = '';
                }

